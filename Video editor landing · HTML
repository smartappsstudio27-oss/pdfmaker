<style>
  :root{
    --bg: #14181C;
    --surface: #1B2126;
    --surface-2: #212930;
    --text: #F2EFE9;
    --text-muted: #93A0A6;
    --accent: #E8A33D;   /* film amber */
    --accent-2: #E1524F; /* rec red */
    --line: #333D44;
    --radius: 10px;
  }
  *{ box-sizing:border-box; margin:0; padding:0; }
  html{ scroll-behavior:smooth; }
  body{
    background:var(--bg);
    color:var(--text);
    font-family:'Inter', sans-serif;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.display{
    font-family:'Anton', sans-serif;
    font-weight:400;
    letter-spacing:0.5px;
    text-transform:uppercase;
    line-height:1.05;
  }
  .mono{ font-family:'IBM Plex Mono', monospace; letter-spacing:0.5px; }
  a{ color:inherit; text-decoration:none; }
  img{ max-width:100%; display:block; }
  .wrap{ max-width:1160px; margin:0 auto; padding:0 24px; }
  .muted{ color:var(--text-muted); }

  /* ---------- Focus ---------- */
  a:focus-visible, button:focus-visible, summary:focus-visible{
    outline:2px solid var(--accent);
    outline-offset:3px;
  }

  /* ---------- Header ---------- */
  header{
    position:sticky; top:0; z-index:50;
    background:rgba(20,24,28,0.9);
    backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
  }
  .nav{
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 24px;
  }
  .logo{
    display:flex; align-items:center; gap:8px;
    font-family:'Anton', sans-serif; font-size:22px; text-transform:uppercase;
  }
  .logo .dot{ width:10px; height:10px; border-radius:50%; background:var(--accent-2); box-shadow:0 0 10px var(--accent-2); }
  .nav-links{ display:flex; gap:32px; font-size:14px; font-weight:600; }
  .nav-links a{ color:var(--text-muted); transition:color .2s; }
  .nav-links a:hover{ color:var(--text); }
  .btn{
    display:inline-flex; align-items:center; gap:8px;
    padding:11px 22px; border-radius:6px;
    font-weight:700; font-size:14px; cursor:pointer; border:none;
    transition:transform .15s ease, box-shadow .15s ease;
  }
  .btn-primary{ background:var(--accent); color:#181410; }
  .btn-primary:hover{ transform:translateY(-2px); box-shadow:0 6px 20px rgba(232,163,61,0.35); }
  .btn-ghost{ background:transparent; color:var(--text); border:1px solid var(--line); }
  .btn-ghost:hover{ border-color:var(--text-muted); }

  /* ---------- Hero ---------- */
  .hero{ padding:76px 0 40px; }
  .hero-grid{ display:grid; grid-template-columns:1.05fr 0.95fr; gap:56px; align-items:center; }
  .eyebrow{
    display:inline-flex; align-items:center; gap:8px;
    font-family:'IBM Plex Mono', monospace; font-size:12px; color:var(--accent);
    border:1px solid rgba(232,163,61,0.35); background:rgba(232,163,61,0.08);
    padding:6px 12px; border-radius:20px; margin-bottom:20px;
  }
  .eyebrow .rec{ width:7px; height:7px; border-radius:50%; background:var(--accent-2); animation:blink 1.4s infinite; }
  @keyframes blink{ 50%{ opacity:.25; } }
  h1{ font-size:52px; margin-bottom:18px; }
  h1 span{ color:var(--accent); }
  .hero p.lead{ font-size:17px; color:var(--text-muted); max-width:480px; margin-bottom:32px; }
  .hero-ctas{ display:flex; gap:14px; margin-bottom:28px; flex-wrap:wrap; }
  .hero-note{ font-size:13px; color:var(--text-muted); }

  /* ---------- Timeline mockup (signature element) ---------- */
  .timeline-card{
    background:var(--surface); border:1px solid var(--line); border-radius:var(--radius);
    padding:20px; box-shadow:0 20px 60px rgba(0,0,0,0.35);
  }
  .tl-topbar{ display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; }
  .tl-dots{ display:flex; gap:6px; }
  .tl-dots span{ width:9px; height:9px; border-radius:50%; background:var(--line); }
  .tl-time{ font-family:'IBM Plex Mono', monospace; font-size:13px; color:var(--accent); }
  .preview{
    background:linear-gradient(135deg,#232b31,#171c20);
    border:1px solid var(--line); border-radius:8px;
    aspect-ratio:16/9; position:relative; overflow:hidden; margin-bottom:16px;
    display:flex; align-items:center; justify-content:center;
  }
  .preview .playbtn{
    width:56px; height:56px; border-radius:50%;
    background:rgba(242,239,233,0.1); border:1px solid rgba(242,239,233,0.3);
    display:flex; align-items:center; justify-content:center;
  }
  .preview .playbtn::after{
    content:''; border-style:solid; border-width:9px 0 9px 15px;
    border-color:transparent transparent transparent var(--text);
    margin-left:4px;
  }
  .preview .grain{
    position:absolute; inset:0;
    background:repeating-linear-gradient(0deg, rgba(255,255,255,0.02) 0px, rgba(255,255,255,0.02) 1px, transparent 1px, transparent 3px);
  }
  .tracks{ display:flex; flex-direction:column; gap:8px; }
  .track{ display:flex; gap:3px; height:30px; position:relative; }
  .clip{ border-radius:4px; height:100%; opacity:0.9; }
  .track .playhead{
    position:absolute; top:-4px; bottom:-4px; width:2px; background:var(--accent-2);
    box-shadow:0 0 8px var(--accent-2);
    animation:scrub 5s linear infinite;
  }
  @keyframes scrub{ 0%{ left:0%; } 100%{ left:97%; } }

  /* ---------- Ad slots ---------- */
  .ad-slot{
    margin:48px auto; display:flex; flex-direction:column; align-items:center; gap:6px;
  }
  .ad-slot .ad-label{ font-family:'IBM Plex Mono', monospace; font-size:11px; color:var(--text-muted); letter-spacing:1px; }
  .ad-box{
    width:100%; border:1px dashed var(--line); border-radius:8px;
    background:var(--surface); color:var(--text-muted);
    display:flex; align-items:center; justify-content:center;
    font-size:13px; font-family:'IBM Plex Mono', monospace;
