  .ad-rectangle{ max-width:336px; height:280px; }
  .ad-banner{ max-width:970px; height:90px; }

  /* ---------- Section shell ---------- */
  section{ padding:64px 0; }
  .section-head{ text-align:center; max-width:600px; margin:0 auto 48px; }
  .section-head .eyebrow{ margin-bottom:16px; }
  .section-head h2{ font-size:34px; margin-bottom:12px; }
  .section-head p{ color:var(--text-muted); font-size:15px; }

  /* timecode divider used as structural device instead of numbers */
  .tc-divider{
    display:flex; align-items:center; gap:12px; color:var(--text-muted);
    font-family:'IBM Plex Mono', monospace; font-size:12px; margin-bottom:16px;
  }
  .tc-divider::after{ content:''; flex:1; height:1px; background:var(--line); }

  /* ---------- Features ---------- */
  .features-grid{
    display:grid; grid-template-columns:repeat(3,1fr); gap:20px;
  }
  .feature{
    background:var(--surface); border:1px solid var(--line); border-radius:var(--radius);
    padding:26px; transition:border-color .2s, transform .2s;
  }
  .feature:hover{ border-color:var(--accent); transform:translateY(-3px); }
  .feature .icon{
    width:38px; height:38px; border-radius:8px; background:var(--surface-2);
    display:flex; align-items:center; justify-content:center; margin-bottom:16px;
    color:var(--accent); font-size:18px;
  }
  .feature h3{ font-size:16px; text-transform:none; font-family:'Inter',sans-serif; font-weight:700; margin-bottom:8px; letter-spacing:0; }
  .feature p{ font-size:14px; color:var(--text-muted); }

  /* ---------- Steps ---------- */
  .steps{ display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
  .step{ position:relative; padding-left:0; }
  .step .in-out{ display:flex; justify-content:space-between; font-family:'IBM Plex Mono',monospace; font-size:11px; color:var(--accent); margin-bottom:10px; }
  .step h3{ font-size:18px; font-family:'Inter',sans-serif; text-transform:none; letter-spacing:0; margin-bottom:8px; }
  .step p{ color:var(--text-muted); font-size:14px; }
  .step-bar{ height:4px; border-radius:4px; background:var(--surface-2); margin-bottom:14px; overflow:hidden; }
  .step-bar span{ display:block; height:100%; background:var(--accent); }

  /* ---------- Stats ---------- */
  .stats{
    display:grid; grid-template-columns:repeat(4,1fr); gap:20px;
    background:var(--surface); border:1px solid var(--line); border-radius:var(--radius);
    padding:36px 24px;
  }
  .stat{ text-align:center; }
  .stat .num{ font-family:'Anton',sans-serif; font-size:34px; color:var(--accent); }
  .stat .label{ font-size:12px; color:var(--text-muted); font-family:'IBM Plex Mono',monospace; margin-top:6px; }

  /* ---------- FAQ ---------- */
  .faq{ max-width:720px; margin:0 auto; }
  details{
    border-bottom:1px solid var(--line); padding:18px 0;
  }
  summary{
    cursor:pointer; list-style:none; display:flex; justify-content:space-between;
    align-items:center; font-weight:600; font-size:15px;
  }
  summary::-webkit-details-marker{ display:none; }
  summary::after{ content:'+'; color:var(--accent); font-size:20px; font-family:'Anton',sans-serif; transition:transform .2s; }
  details[open] summary::after{ content:'−'; }
  details p{ color:var(--text-muted); font-size:14px; margin-top:12px; max-width:600px; }

  /* ---------- CTA band ---------- */
  .cta-band{
    text-align:center; background:linear-gradient(135deg, var(--surface), var(--surface-2));
    border:1px solid var(--line); border-radius:var(--radius); padding:56px 24px;
  }
  .cta-band h2{ font-size:30px; margin-bottom:14px; }
  .cta-band p{ color:var(--text-muted); margin-bottom:28px; }

  /* ---------- Footer ---------- */
  footer{ border-top:1px solid var(--line); padding:36px 0; }
  .footer-row{ display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; }
  .footer-links{ display:flex; gap:24px; font-size:13px; color:var(--text-muted); flex-wrap:wrap; }
  .footer-links a:hover{ color:var(--text); }

  /* ---------- Responsive ---------- */
  @media (max-width:860px){
    .hero-grid{ grid-template-columns:1fr; }
    h1{ font-size:38px; }
    .features-grid{ grid-template-columns:1fr 1fr; }
    .steps{ grid-template-columns:1fr; }
    .stats{ grid-template-columns:1fr 1fr; }
    .nav-links{ display:none; }
  }
  @media (max-width:500px){
    .features-grid{ grid-template-columns:1fr; }
    .stats{ grid-template-columns:1fr 1fr; }
    h1{ font-size:32px; }
  }

  @media (prefers-reduced-motion: reduce){
    .track .playhead{ animation:none; left:20%; }
    .eyebrow .rec{ animation:none; }
  }
</style>
</head>
