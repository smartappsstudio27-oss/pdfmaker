<script>
  // Ticking timecode readout in the hero mockup (purely decorative)
  (function(){
    var el = document.getElementById('tcReadout');
    if(!el) return;
    var frames = 4, seconds = 12, minutes = 0, hours = 0;
    setInterval(function(){
      frames++;
      if(frames > 29){ frames = 0; seconds++; }
      if(seconds > 59){ seconds = 0; minutes++; }
      if(minutes > 59){ minutes = 0; hours++; }
      function pad(n){ return n.toString().padStart(2,'0'); }
      el.textContent = pad(hours)+':'+pad(minutes)+':'+pad(seconds)+':'+pad(frames);
    }, 100);
  })();
</script>

